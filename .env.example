# ============================================
# DevSphere Centralized Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# ============ FRONTEND ============
VITE_FRONTEND_PORT=5173
VITE_BACKEND_API_URL=http://localhost:5001
VITE_CODINGBUDDY_API_URL=http://localhost:8000

# ============ BACKEND (DevSphere) ============
BACKEND_PORT=5001
JWT_SECRET=your_random_jwt_secret_here_change_this

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@host:5432/database_name

# AI Service (Google Gemini)
GEMINI_API_KEYS=your_gemini_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ============ CODING BUDDY BACKEND ============
CODINGBUDDY_PORT=8000
CODINGBUDDY_FRONTEND_URL=http://localhost:5174

# CORS Origins (comma-separated)
CODINGBUDDY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# ============ CODING BUDDY FRONTEND ============
VITE_CODINGBUDDY_CLIENT_PORT=5174

# ============ ENVIRONMENT ============
NODE_ENV=development
# For production use: NODE_ENV=production

# ============ NOTES ============
# Frontend runs on: 5173
# Backend (DevSphere) runs on: 5001
# CodingBuddy Backend runs on: 8000
# CodingBuddy Frontend runs on: 5174

# ============ PRODUCTION VALUES ============
# Update these when deploying to production:
# VITE_BACKEND_API_URL=https://api.devsphere.com
# VITE_CODINGBUDDY_API_URL=https://api.codingbuddy.com
# FRONTEND_URL=https://devsphere.com
# CODINGBUDDY_FRONTEND_URL=https://codingbuddy.com
# NODE_ENV=production
